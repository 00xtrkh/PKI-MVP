# MiniPKI local secrets — DO NOT COMMIT (already in .gitignore)
#
# Copy from .env.example and set a strong passphrase of your own.

# Required: encrypts private-key PEM blobs at rest (PKCS#8 BestAvailableEncryption)
MINIPKI_PRIVATE_KEY_PASSPHRASE=change-me-to-a-long-random-secret

# Required for web admin actions (issue + revoke). UI login / API Basic user ``admin``.
MINIPKI_ADMIN_PASSWORD=change-me-admin-password

# Optional: Flask session secret (set a random value in production)
# MINIPKI_FLASK_SECRET=change-me-flask-secret

# Optional: bind address for ``python -m pki.web`` / Docker
# MINIPKI_HOST=0.0.0.0
# MINIPKI_PORT=5000
# MINIPKI_DEBUG=0

# Optional: host port published by docker compose (maps to container 5000)
# MINIPKI_PUBLISH_PORT=5000

# Optional overrides (defaults shown)
# MINIPKI_CA_KEY_SIZE=4096
# MINIPKI_CLIENT_KEY_SIZE=2048
# MINIPKI_MIN_KEY_SIZE=2048
# MINIPKI_CA_CN=MiniPKI Root CA
# MINIPKI_CA_ORG=MiniPKI
# MINIPKI_CA_COUNTRY=MA
# MINIPKI_CA_VALIDITY_DAYS=3650
# MINIPKI_CLIENT_VALIDITY_DAYS=365
# MINIPKI_CLIENT_ORG=MiniPKI Clients
# MINIPKI_CRL_NEXT_UPDATE_DAYS=7
# MINIPKI_STORAGE_DIR=storage
# MINIPKI_DATABASE_NAME=minipki.db
